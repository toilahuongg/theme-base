    "45e4c2ac-12b8-4ed1-a789-75b4dbc9c578": {
      "type": "multicolumn",
      "blocks": {
        "template--17157701599458__45e4c2ac-12b8-4ed1-a789-75b4dbc9c578-column-1": {
          "type": "column",
          "settings": {
            "title": "Hand-strung",
            "heading_size": "h4",
            "text": "<p>Every Miyuki bead bracelet is strung one bead at a time, in natural light, by a stringer who checks each bead twice.</p>",
            "text_size": "medium",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--underline",
            "image": "shopify://shop_images/promise-beadwork.png"
          }
        },
        "23738779-93a8-4a1b-aa4a-382808fc8419": {
          "type": "column",
          "settings": {
            "title": "Repaired for life",
            "heading_size": "h4",
            "text": "<p>Gold vermeil is re-polished and bead bracelets re-strung free, forever. Jewelry built to be repaired, not rebought.</p>",
            "text_size": "medium",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--underline",
            "image": "shopify://shop_images/promise-tools.png"
          }
        },
        "62b69dd1-a1f1-4028-9f0c-bf65a341a11c": {
          "type": "column",
          "settings": {
            "title": "Honest materials",
            "heading_size": "h4",
            "text": "<p>Recycled sterling silver, pearls from family farms, lab-grown diamonds — materials we can trace and explain.</p>",
            "text_size": "medium",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--underline",
            "image": "shopify://shop_images/promise-gold.png"
          }
        }
