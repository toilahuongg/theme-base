    "16540504704fa88658": {
      "type": "image-with-text",
      "blocks": {
        "1654050470051141b0-0": {
          "type": "heading",
          "settings": {
            "heading": "Materials with <em>a story</em>",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h1"
          }
        },
        "1654050470051141b0-1": {
          "type": "text",
          "settings": {
            "text": "<p>Miyuki beads made in Japan since 1949. 18K gold vermeil — two and a half microns of gold over recycled sterling. Freshwater pearls from family-run farms. Lab-grown diamonds cut to the same standard as mined stones. We can tell you where every material comes from — because we buy direct, and we care.</p>"
          }
        }
      },
      "block_order": [
