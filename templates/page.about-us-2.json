    "16540503155db15864": {
      "type": "image-with-text",
      "blocks": {
        "1654050315a020c10e-0": {
          "type": "heading",
          "settings": {
            "heading": "The workshop, <em>by hand</em>",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h1"
          }
        },
        "1654050315a020c10e-1": {
          "type": "text",
          "settings": {
            "text": "<p>Our workshop is a quiet room with a long table. Beads are sorted into gradients in natural light; gold is cast, polished, and checked twice; pearls are matched one against another until the pairing feels inevitable. It is slow work, and we intend to keep it that way.</p>"
          }
        }
      },
