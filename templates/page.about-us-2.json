        "template--17157701599458__a16d91be-b626-44c9-8cae-a679dc435c62-column-2": {
          "type": "column",
          "settings": {
            "title": "Lifetime repair",
            "heading_size": "h3",
            "text": "<p>Re-polishing, re-stringing, and small repairs are free, forever — just send the piece to the workshop.</p>",
