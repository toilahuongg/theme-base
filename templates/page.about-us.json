        },
        "column_EzWchN": {
          "type": "column",
          "settings": {
            "show_image": true,
            "image_link": "",
            "title": "Meaningful connection",
            "heading_size": "h4",
            "text": "<p>With our jewelry, you can carry a piece of yourself wherever you go and create lasting memories that resonate with meaning.</p>",
            "text_size": "medium",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--underline"
          }
        },
        "column_eE7R8K": {
          "type": "column",
          "settings": {
            "show_image": true,
            "image_link": "",
            "title": "Versatile wearability",
            "heading_size": "h4",
            "text": "<p>Whether you're layering necklaces for a bohemian-chic look or stacking rings for a bold statement, our jewelry offers endless styling.</p>",
            "text_size": "medium",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--underline"
          }
        }
      },
