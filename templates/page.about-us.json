    "custom_content_r9Vep3": {
      "type": "custom-content",
      "blocks": {
        "image_NVbbzk": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/1_7902c3e2-670c-4dec-81e7-1e621e194067.webp",
