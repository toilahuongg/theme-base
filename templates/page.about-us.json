    "custom_content_gcYmxM": {
      "type": "custom-content",
      "blocks": {
        "text_A8ydNQ": {
          "type": "text",
          "settings": {
            "color_scheme": "scheme-10",
            "title": "THE INSPIRATION",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h2",
            "heading_color": "",
            "subheading": "",
            "text": "<p>Every Veloura collection starts with a feeling — the warmth of a long summer evening, the quiet of a workshop at first light, the memory of a grandmother's hands. From there we choose materials that hold that feeling: beads made in Hiroshima since 1949, pearls from family farms, gold thick enough to last a lifetime.</p><p>We design slowly and make by hand, because jewelry that's rushed never earns its place in a story.</p>",
            "alignment": "center",
            "align_text": "left",
            "padding_left": 20,
            "padding_right": 20,
            "align_content_container": "none",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--primary",
