      "blocks": {
        "content_6rgj3J": {
          "type": "content",
          "settings": {
            "icon": "none",
            "title": "How long does it take to process an order?",
            "content": "<p>Orders are processed within 1-3 business days. You’ll receive a confirmation email once your order has been shipped, ensuring a smooth shopping experience.</p>",
            "custom_liquid": "",
            "content_page": "",
            "open": true
          }
        },
        "content_DBBkLp": {
          "type": "content",
          "settings": {
            "icon": "none",
            "title": "Do you ship internationally?",
            "content": "<p>Yes, we offer international shipping. Delivery times vary by location, and shipping costs are calculated at checkout for seamless worldwide service.</p>",
            "custom_liquid": "",
            "content_page": "",
            "open": false
          }
        },
        "content_TDYWn3": {
          "type": "content",
          "settings": {
            "icon": "none",
            "title": "What is your return policy?",
            "content": "<p>We accept returns within 30 days of delivery. Items must be unused, in original packaging, and accompanied by a receipt for a hassle-free return process.</p>",
            "custom_liquid": "",
            "content_page": "",
            "open": false
          }
        },
        "content_GiXT36": {
          "type": "content",
          "settings": {
            "icon": "none",
            "title": "Can I track my order?",
            "content": "<p>Yes! Once your order ships, we’ll send a tracking number via email so you can monitor your package's journey with real-time updates available online.</p>",
            "custom_liquid": "",
            "content_page": "",
            "open": false
          }
        }
      },
