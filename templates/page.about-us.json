      "blocks": {
        "column_ypYLBH": {
          "type": "column",
          "settings": {
            "show_image": true,
            "image_link": "",
            "title": "Timeless elegance",
            "heading_size": "h4",
            "text": "<p>Crafted with attention to detail and a keen eye for design, each piece exudes a sense of refined luxury that transcends trends and fads.</p>",
            "text_size": "medium",
            "button_text": "",
            "button_link": "",
            "button_style": "btn--underline"
