{{ 'scroll-scrub-video.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'scroll-scrub-video.js' | asset_url }}"
  defer="defer"
></script>
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
-%}
<style>
  .section-{{ section.id }} {
    --scroll-height: {{ section.settings.scroll_height_vh }}vh;
    {%- if section.settings.background_color != blank -%}
      --scroll-scrub-bg: {{ section.settings.background_color }};
    {%- endif -%}
  }
</style>
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<scroll-scrub-video
  id="{{ section_id }}"
  class="section-{{ section.id }} scroll-scrub-video{{ custom_class }}"
>
  <div class="scroll-scrub-video__sticky">
    {%- if section.settings.video != blank -%}
      <video
        class="scroll-scrub-video__media"
        muted
        playsinline
        preload="auto"
        {%- if section.settings.poster != blank -%}
          poster="{{ section.settings.poster | image_url: width: 1920 }}"
        {%- endif -%}
      >
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif section.settings.poster != blank -%}
      {{
        section.settings.poster
        | image_url: width: 1920
        | image_tag:
          loading: 'lazy',
          widths: '750,1100,1500,1920',
          sizes: '100vw',
          alt: section.settings.poster.alt | escape
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'scroll-scrub-video__placeholder' }}
    {%- endif -%}
    <div class="scroll-scrub-video__overlay" aria-hidden="true"></div>
    <div class="scroll-scrub-video__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="scroll-scrub-video__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  </div>
</scroll-scrub-video>

{% schema %}
{
  "name": "Scroll scrub video",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.general.name"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "The video timeline is scrubbed by scrolling through this section."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown before the video loads, and used as the section visual when no video is selected."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Scroll = timeline."
    },
    {
      "type": "range",
      "id": "scroll_height_vh",
      "label": "Scroll height",
      "info": "Scroll distance (in viewport heights) mapped across the full video duration.",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "vh",
      "default": 260
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to use the default dark backdrop."
    },
    {
      "type": "header",
      "content": "t:sections.common.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "t:sections.common.divider.show_divider.label",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_width",
      "label": "t:sections.common.divider.width.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.common.container.fixed"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.common.container.stretched"
        },
        {
          "value": "container-full",
          "label": "t:sections.common.container.fullwidth"
        }
      ],
      "default": "container",
      "visible_if": "{{ section.settings.show_section_divider == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.custom_attr.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.common.custom_attr.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.custom_attr.custom_class"
    },
    {
      "type": "header",
      "content": "t:settings_schema.animations.header.content"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "t:settings_schema.animations.header__2.content",
      "options": [
        {
          "value": "inherit",
          "label": "t:settings_schema.animations.settings.animation.options.option_6"
        },
        {
          "value": "fade-in",
          "label": "t:settings_schema.animations.settings.animation.options.option_2"
        },
        {
          "value": "fade-in-up",
          "label": "t:settings_schema.animations.settings.animation.options.option_3"
        },
        {
          "value": "fade-in-left",
          "label": "t:settings_schema.animations.settings.animation.options.option_4"
        },
        {
          "value": "fade-in-right",
          "label": "t:settings_schema.animations.settings.animation.options.option_5"
        }
      ],
      "default": "inherit"
    }
  ],
  "presets": [
    {
      "name": "Scroll scrub video",
      "settings": {
        "heading": "Scroll = timeline.",
        "scroll_height_vh": 260
      }
    }
  ]
}
{% endschema %}
