{{ 'ugc-grid.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'ugc-grid.js' | asset_url }}"
  defer="defer"
></script>
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
-%}
<style>
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ugc-grid-bg: {{ section.settings.background_color }};
    --ugc-grid-fg: {{ section.settings.text_color }};
    --ugc-grid-muted: {{ section.settings.muted_color }};
    --ugc-grid-line: {{ section.settings.line_color }};
  }
  {%- if section.settings.heading_font_size > 0 -%}
    .section-{{ section.id }} {
      --ugc-grid-heading-size: min({{ section.settings.heading_font_size }}px, 14vw);
    }
  {%- endif -%}
</style>
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<ugc-grid
  id="{{ section_id }}"
  class="section-{{ section.id }} ugc-grid-section m-section-padding color-{{ section.settings.color_scheme }}{{ custom_class }}"
>
  <motion-element
    data-motion="{{ animation_effect }}"
    class="block"
  >
    <div class="ugc-head">
      <div>
        {%- if section.settings.subheading != blank -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            class="block"
          >
            <span class="ugc-kicker">{{ section.settings.subheading }}</span>
          </motion-element>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>
            <motion-element
              data-motion="{{ animation_effect }}"
              data-motion-delay="50"
              class="block"
            >
              {{ section.settings.heading }}
            </motion-element>
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p>
            <motion-element
              data-motion="{{ animation_effect }}"
              data-motion-delay="100"
              class="block"
            >
              {{ section.settings.description }}
            </motion-element>
          </p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <motion-element
          data-motion="{{ animation_effect }}"
          data-motion-delay="150"
          class="block"
        >
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="ugc-cta"
          >
            {{- section.settings.button_label -}}
          </a>
        </motion-element>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="ugc-grid">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="ugc-card"
            data-image="{{ block.settings.image | image_url: width: 1400 | escape }}"
            data-user="{{ block.settings.user | escape }}"
            data-caption="{{ block.settings.caption | escape }}"
            data-product="{{ block.settings.product | escape }}"
            data-link="{{ block.settings.product_link | escape }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '300,540,720,900,1200',
                  sizes: '(min-width: 990px) 35vw, 100vw',
                  alt: block.settings.caption | default: block.settings.user | escape
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="ugc-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.media_type == 'video' -%}
              <span class="play-icon" aria-hidden="true">{%- render 'icon-play', size: 'medium' -%}</span>
            {%- endif -%}
            <div class="ugc-meta">
              <div class="ugc-user">
                {%- if block.settings.user != blank -%}
                  <strong>{{ block.settings.user }}</strong>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <span>{{ block.settings.caption }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.product != blank -%}
                <span class="ugc-product">{{ block.settings.product }}</span>
              {%- endif -%}
            </div>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </motion-element>

  <div class="ugc-modal" aria-hidden="true">
    <div class="ugc-dialog" role="dialog" aria-modal="true">
      <div class="ugc-dialog-media">
        <img class="ugc-modal__image" src="" alt="">
      </div>
      <div class="ugc-dialog-copy">
        <button type="button" class="close-btn ugc-modal__close" aria-label="Close">{%- render 'icon-close', size: 'medium' -%}</button>
        <h3 class="ugc-modal__user"></h3>
        <p class="ugc-modal__caption"></p>
        <strong class="ugc-modal__product"></strong>
        <a class="shop-btn ugc-modal__shop" href="#" hidden>Shop this product</a>
      </div>
    </div>
  </div>
</ugc-grid>
{% schema %}
{
  "name": "UGC grid",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.common.color_schema.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f6f3ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "default": "#777168"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "rgba(20, 20, 20, 0.12)"
    },
    {
      "type": "header",
      "content": "t:sections.common.header.name"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Kicker",
      "default": "UGC / Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn by you."
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Custom heading size",
      "info": "Leave 0 to use the section's fluid heading size.",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Real customer photos give your products context, scale and everyday feeling — especially effective for fashion, jewelry, bags and beauty."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View community →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.section_padding.top_padding.label",
      "default": 84,
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.section_padding.bottom_padding.label",
      "default": 84,
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:sections.common.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "t:sections.common.divider.show_divider.label",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_width",
      "label": "t:sections.common.divider.width.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.common.container.fixed"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.common.container.stretched"
        },
        {
          "value": "container-full",
          "label": "t:sections.common.container.fullwidth"
        }
      ],
      "default": "container",
      "visible_if": "{{ section.settings.show_section_divider == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.custom_attr.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.common.custom_attr.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.custom_attr.custom_class"
    },
    {
      "type": "header",
      "content": "t:settings_schema.animations.header.content"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "t:settings_schema.animations.header__2.content",
      "options": [
        {
          "value": "inherit",
          "label": "t:settings_schema.animations.settings.animation.options.option_6"
        },
        {
          "value": "fade-in",
          "label": "t:settings_schema.animations.settings.animation.options.option_2"
        },
        {
          "value": "fade-in-up",
          "label": "t:settings_schema.animations.settings.animation.options.option_3"
        },
        {
          "value": "fade-in-left",
          "label": "t:settings_schema.animations.settings.animation.options.option_4"
        },
        {
          "value": "fade-in-right",
          "label": "t:settings_schema.animations.settings.animation.options.option_5"
        }
      ],
      "default": "inherit"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
