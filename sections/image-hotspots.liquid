{{ 'image-hotspots.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign container = section.settings.container
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif

  assign hotspot_alt = section.settings.image.alt | escape
-%}
<style>
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  {%- if section.settings.heading_font_size > 0 -%}
    .section-{{ section.id }} .section__heading {
      font-size: min({{ section.settings.heading_font_size }}px, 14vw);
    }
  {%- endif -%}
</style>
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<div
  id="{{ section_id }}"
  class="section-{{ section.id }} image-hotspots m-section-padding color-{{ section.settings.color_scheme }}{{ custom_class }}"
>
  <motion-element
    data-motion="{{ animation_effect }}"
    class="block {{ container }}"
  >
    {%- render 'index-section-header',
      section_settings: section.settings,
      animation_effect: animation_effect
    -%}
    <div
      class="image-hotspots__stage"
      style="--image-hotspots-ratio: {{ section.settings.image_ratio }}"
    >
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '720,940,1066,1200,1600',
            sizes: '100vw',
            alt: hotspot_alt,
            class: 'image-hotspots__image'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg image-hotspots__image' }}
      {%- endif -%}
      {%- for block in section.blocks -%}
        <div
          class="image-hotspots__pin"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
          {{ block.shopify_attributes }}
        >
          <span class="image-hotspots__dot" aria-hidden="true"></span>
          <div class="image-hotspots__card">
            {%- if block.settings.title != blank -%}
              <b class="image-hotspots__title">{{ block.settings.title }}</b>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <small class="image-hotspots__text">{{ block.settings.description }}</small>
            {%- endif -%}
            {%- if block.settings.url != blank -%}
              <a class="image-hotspots__link" href="{{ block.settings.url }}">Learn more</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </motion-element>
</div>
{% schema %}
