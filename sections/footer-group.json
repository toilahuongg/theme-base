{
  "type": "footer",
  "name": "t:sections.footer.name",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "footer-newsletter": {
          "type": "newsletter",
          "settings": {
            "heading": "The atelier newsletter",
            "heading_size": "h6",
            "subheading": "<p>New pieces, craft notes, and early access — once a month, never more.</p>",
            "description": "<p>By subscribing you agree to our Terms of Use and Privacy Policy.</p>",
            "email_placeholder": "Email address",
            "hide_label": true,
            "form_width": 420,
            "width": 30,
            "open_default_collapsible_tab": true,
            "show_divider": false
          }
        },
        "footer-shop": {
          "type": "link_list",
          "settings": {
            "heading": "Shop",
            "heading_size": "h6",
            "menu": "footer",
            "width": 20,
            "open_default_collapsible_tab": true,
            "show_divider": false
          }
        },
        "footer-care": {
          "type": "link_list",
          "settings": {
            "heading": "Customer Care",
            "heading_size": "h6",
            "menu": "footer-services",
            "width": 20,
            "open_default_collapsible_tab": true,
            "show_divider": false
          }
        },
        "footer-about": {
          "type": "link_list",
          "settings": {
            "heading": "About",
            "heading_size": "h6",
            "menu": "footer-about",
            "width": 20,
            "open_default_collapsible_tab": true,
            "show_divider": false
          }
        },
        "footer-contact": {
          "type": "text",
          "settings": {
            "heading": "The Atelier",
            "heading_size": "h6",
            "subtext": "<p>Veloura Studio<br>212 Crosby Street, New York</p><p>care@veloura.com<br>Mon–Sat, 10am–6pm</p>",
            "width": 10,
            "open_default_collapsible_tab": true,
            "show_divider": false
          }
        }
      },
      "block_order": [
        "footer-newsletter",
        "footer-shop",
        "footer-care",
        "footer-about",
        "footer-contact"
      ],
      "custom_css": [
        "@media (min-width: 1023.98px) {[data-column-type=\"newsletter\"] {justify-content: flex-end; order: 9; }}"
      ],
      "settings": {
        "container": "container",
        "color_schema": "background-2",
        "show_copyright": true,
        "show_divider": true,
        "enable_follow_on_shop": true,
        "show_social": true,
        "icon_size": "extra-medium",
        "enable_country_selector": true,
        "enable_language_selector": false,
        "show_payments": true,
        "bottom_menu": "footer-about",
        "animations": "fade-in-up"
      }
    },
    "mobile-sticky-bar": {
      "type": "mobile-sticky-bar",
      "blocks": {
        "mobile-sticky-bar-0": {
          "type": "home",
          "settings": {
            "text": "Home"
          }
        },
        "mobile-sticky-bar-1": {
          "type": "products",
          "settings": {
            "text": "Products",
            "collection": "best-sellers"
          }
        },
        "mobile-sticky-bar-2": {
          "type": "search",
          "settings": {
            "text": "Search"
          }
        },
        "mobile-sticky-bar-3": {
          "type": "cart",
          "settings": {
            "text": "Cart"
          }
        }
      },
      "block_order": [
        "mobile-sticky-bar-0",
        "mobile-sticky-bar-1",
        "mobile-sticky-bar-2",
        "mobile-sticky-bar-3"
      ],
      "settings": {
        "enable_sticky_bar": true,
        "show_text": true
      }
    },
    "popup": {
      "type": "popup",
      "blocks": {
        "image": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/p-pearlneck-1.png",
            "image_position": "left"
          }
        },
        "popup-0": {
          "type": "heading",
          "settings": {
            "heading": "Join the atelier list",
            "text_size": "large"
          }
        },
        "popup-1": {
          "type": "text",
          "settings": {
            "text": "<p>New pieces, craft notes, and early access to seasonal edits. One email a month, never more.</p>"
          }
        },
        "popup-2": {
          "type": "form",
          "settings": {
            "design": "design-2",
            "button_label": "Subscribe"
          }
        }
      },
      "block_order": [
        "image",
        "popup-0",
        "popup-1",
        "popup-2"
      ],
      "settings": {
        "design_mode": false,
        "enable": true,
        "show_for_homepage_only": true,
        "show_for_visitors_only": true,
        "trigger_open": "immediately",
        "repeat_open": "every_30_mins",
        "alignment": "left",
        "width": 860,
        "show_teaser": false,
        "teaser_button_text": "Newsletter",
        "teaser_popup_bg": "#1437aa",
        "teaser_popup_text": "#ffffff"
      }
    },
    "age-verifier-popup": {
      "type": "age-verifier-popup",
      "blocks": {
        "age-vefirifer-popup-1": {
          "type": "heading",
          "disabled": true,
          "settings": {
            "heading": "Confirm your age",
            "heading_size": "h1"
          }
        },
        "age-vefirifer-popup-2": {
          "type": "text",
          "disabled": true,
          "settings": {
            "text": "<p>Are you 18 years old or older?</p>"
          }
        },
        "age-vefirifer-popup-3": {
          "type": "buttons",
          "disabled": true,
          "settings": {
            "decline_button": "No, I'm not",
            "approve_button": "Yes, I am"
          }
        }
      },
      "block_order": [
        "age-vefirifer-popup-1",
        "age-vefirifer-popup-2",
        "age-vefirifer-popup-3"
      ],
      "disabled": true,
      "settings": {
        "design_mode": false,
        "enable": false,
        "bg_blur": true,
        "decline_heading": "Come back when you're older",
        "decline_content": "<p>Sorry, the content of this store can't be seen by a younger audience. Come back when you're older.</p>",
        "return_button": "Oops, I entered incorrectly"
      }
    }
  },
  "order": [
    "footer",
    "mobile-sticky-bar",
    "popup",
    "age-verifier-popup"
  ]
}
