{{ 'ugc-story-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gsap.js' | asset_url }}" defer="defer"></script>
<script
  src="{{ 'ugc-story-carousel.js' | asset_url }}"
  defer="defer"
></script>
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
-%}
<style>
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ugc-story-bg: {{ section.settings.background_color }};
    --ugc-story-ink: {{ section.settings.ink_color }};
    --ugc-story-muted: {{ section.settings.muted_color }};
    --ugc-story-accent: {{ section.settings.accent_color }};
    --ugc-story-card-w: {{ section.settings.card_width }}px;
  }
</style>

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<ugc-story-carousel
  id="{{ section_id }}"
  class="section-{{ section.id }} ugc-story-carousel m-section-padding color-{{ section.settings.color_scheme }}{{ custom_class }}"
  data-slide-duration="{{ section.settings.slide_duration }}"
  data-autoplay="{{ section.settings.autoplay }}"
>
  <section class="ugc-story">
    <!-- LEFT -->
    <div class="ugc-copy">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            class="block"
          >
            <p class="ugc-eyebrow">{{ section.settings.eyebrow }}</p>
          </motion-element>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            data-motion-delay="50"
            class="block"
          >
            <h2 class="ugc-title">{{ section.settings.title }}</h2>
          </motion-element>
        {%- endif -%}
        {%- assign benefits = section.settings.benefits | split: '\n' -%}
        {%- if benefits.size > 0 -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            data-motion-delay="100"
            class="block"
          >
            <ul class="ugc-benefits">
              {%- for benefit in benefits -%}
                {%- unless benefit == blank -%}
                  <li><span class="check">{%- render 'icon-check', size: 'small' -%}</span>{{ benefit }}</li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </motion-element>
        {%- endif -%}
      </div>

      <div class="ugc-pagination"></div>
    </div>

    <!-- RIGHT -->
    <div class="ugc-window">
      <div class="ugc-rail">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <article
              class="ugc-card{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              data-title="{{ block.settings.title | escape }}"
              data-bullets="{{ block.settings.bullets | replace: '\n', '|' | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,540,720,900',
                      sizes: '(min-width: 990px) 30vw, 100vw',
                      alt: block.settings.title | default: section.settings.title | escape
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="media-controls">
                <button type="button" class="icon-btn mute-btn" data-muted="true" aria-label="Unmute">
                  <span class="icon-state-sound" hidden>{%- render 'icon-volume', size: 'medium' -%}</span>
                  <span class="icon-state-muted">{%- render 'icon-volume-mute', size: 'medium' -%}</span>
                </button>
                <button type="button" class="icon-btn pause-btn" aria-label="Pause">
                  <span class="icon-state-pause">{%- render 'icon-pause', size: 'medium' -%}</span>
                  <span class="icon-state-play" hidden>{%- render 'icon-play', size: 'medium' -%}</span>
                </button>
              </div>

              {%- if block.settings.product != blank -%}
                {%- assign block_product = block.settings.product -%}
                {%- if block_product.featured_image != blank -%}
                <div class="product-mini">
                  {{
                    block_product.featured_image
                    | image_url: width: 250
                    | image_tag: loading: 'lazy', alt: ''
                  }}
                </div>
                {%- endif -%}

                <div class="product-full">
                  <div class="product-thumb">
                    {%- if block_product.featured_image != blank -%}
                      {{
                        block_product.featured_image
                        | image_url: width: 250
                        | image_tag: loading: 'lazy', alt: ''
                      }}
                    {%- endif -%}
                  </div>
                  <div class="product-info">
                    <strong>{{ block_product.title }}</strong>
                    <span>{{ block_product.price | money }}</span>
                  </div>
                  <product-form
                    data-type="product-card"
                    data-notification-type="toast"
                  >
                    {%- form 'product', block_product, novalidate: 'novalidate' -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ block_product.selected_or_first_available_variant.id }}"
                      >
                      <button
                        type="submit"
                        name="add"
                        class="cart-btn"
                        aria-label="Add to bag"
                      >
                        <span class="icon-state-bag">{%- render 'icon-shopping-bag', size: 'medium' -%}</span>
                        {% comment %} theme-check-disable {% endcomment %}
                        {{- 'icon-spinner.svg' | inline_asset_content -}}
                        {% comment %} theme-check-enable {% endcomment %}
                      </button>
                    {%- endform -%}
                  </product-form>
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="story-progress-mobile" aria-hidden="true">
        <span class="story-progress-mobile__bar"></span>
      </div>
    </div>
  </section>
</ugc-story-carousel>
{% schema %}
{
