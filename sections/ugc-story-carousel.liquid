{{ 'ugc-story-carousel.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'ugc-story-carousel.js' | asset_url }}"
  defer="defer"
></script>
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign custom_class = section.settings.custom_class

  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign animation_effect = settings.animations
  if animation_effect != 'none' and section.settings.animations != 'inherit'
    assign animation_effect = section.settings.animations
  endif
-%}
<style>
  .section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.background_color != blank -%}
      --ugc-story-bg: {{ section.settings.background_color }};
    {%- endif -%}
    {%- if section.settings.ink_color != blank -%}
      --ugc-story-ink: {{ section.settings.ink_color }};
    {%- endif -%}
    {%- if section.settings.muted_color != blank -%}
      --ugc-story-muted: {{ section.settings.muted_color }};
    {%- endif -%}
    {%- if section.settings.accent_color != blank -%}
      --ugc-story-accent: {{ section.settings.accent_color }};
    {%- endif -%}
    --ugc-story-card-w: {{ section.settings.card_width }}px;
  }
</style>

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<ugc-story-carousel
  id="{{ section_id }}"
  class="section-{{ section.id }} ugc-story-carousel m-section-padding color-{{ section.settings.color_scheme }}{{ custom_class }}"
  data-slide-duration="{{ section.settings.slide_duration }}"
  data-autoplay="{{ section.settings.autoplay }}"
>
  <section class="ugc-story">
    <!-- LEFT -->
    <div class="ugc-copy">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            class="block"
          >
            <p class="ugc-eyebrow">{{ section.settings.eyebrow }}</p>
          </motion-element>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            data-motion-delay="50"
            class="block"
          >
            <h2 class="ugc-title">{{ section.settings.title }}</h2>
          </motion-element>
        {%- endif -%}
          <motion-element
            data-motion="{{ animation_effect }}"
            data-motion-delay="100"
            class="block"
          >
            <ul class="ugc-benefits"></ul>
          </motion-element>
      </div>

      <div class="ugc-pagination"></div>
    </div>

    <!-- RIGHT -->
    <div class="ugc-window">
      <div class="ugc-rail">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign benefit_fields = 'benefit_1,benefit_2,benefit_3' | split: ',' -%}
            {%- assign card_bullets = '' -%}
            {%- for field in benefit_fields -%}
              {%- if block.settings[field] != blank -%}
                {%- assign card_bullets = card_bullets | append: block.settings[field] | append: '|' -%}
              {%- endif -%}
            {%- endfor -%}
            <article
              class="ugc-card{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              data-title="{{ block.settings.title | escape }}"
              data-bullets="{{ card_bullets | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="media">
                {%- liquid
                  assign story_video = block.settings.video
                  assign story_poster = block.settings.image
                  if story_video != blank
                    if story_poster != blank
                      assign story_poster_url = story_poster | image_url: width: 900
                    endif
                  endif
                -%}
                {%- if story_video != blank -%}
                  {{
                    story_video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: 'metadata',
                      class: 'ugc-media-video',
                      poster: story_poster_url,
                      image_size: '900x'
                  }}
                {%- elsif block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360,540,720,900',
                      sizes: '(min-width: 990px) 30vw, 100vw',
                      alt: block.settings.title | default: section.settings.title | escape
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="media-controls">
                {%- if story_video != blank -%}
                <button type="button" class="icon-btn mute-btn" data-muted="true" aria-label="Unmute">
                  <span class="icon-state-sound" hidden>{%- render 'icon-volume', size: 'medium' -%}</span>
                  <span class="icon-state-muted">{%- render 'icon-volume-mute', size: 'medium' -%}</span>
                </button>
                {%- endif -%}
                <button type="button" class="icon-btn pause-btn" aria-label="Pause">
                  <span class="icon-state-pause">{%- render 'icon-pause', size: 'medium' -%}</span>
                  <span class="icon-state-play" hidden>{%- render 'icon-play', size: 'medium' -%}</span>
                </button>
              </div>

              {%- if block.settings.product != blank -%}
                {%- assign block_product = block.settings.product -%}
                {%- if block_product.featured_image != blank -%}
                <div class="product-mini">
                  {{
                    block_product.featured_image
                    | image_url: width: 250
                    | image_tag: loading: 'lazy', alt: ''
                  }}
                </div>
                {%- endif -%}

                <div class="product-full">
                  <div class="product-thumb">
                    {%- if block_product.featured_image != blank -%}
                      {{
                        block_product.featured_image
                        | image_url: width: 250
                        | image_tag: loading: 'lazy', alt: ''
                      }}
                    {%- endif -%}
                  </div>
                  <div class="product-info">
                    <strong>{{ block_product.title }}</strong>
                    <span>{{ block_product.price | money }}</span>
                  </div>
                  <product-form
                    data-type="product-card"
                    data-notification-type="toast"
                  >
                    {%- form 'product', block_product, novalidate: 'novalidate' -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ block_product.selected_or_first_available_variant.id }}"
                      >
                      <button
                        type="submit"
                        name="add"
                        class="cart-btn"
                        aria-label="Add to bag"
                      >
                        <span class="icon-state-bag">{%- render 'icon-shopping-bag', size: 'medium' -%}</span>
                        {% comment %} theme-check-disable {% endcomment %}
                        {{- 'icon-spinner.svg' | inline_asset_content -}}
                        {% comment %} theme-check-enable {% endcomment %}
                      </button>
                    {%- endform -%}
                  </product-form>
                </div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

      <div class="story-progress-mobile" aria-hidden="true">
        <span class="story-progress-mobile__bar"></span>
      </div>
    </div>
  </section>
</ugc-story-carousel>
{% schema %}
{
  "name": "UGC story carousel",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.common.color_schema.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LOVED BY OUR COMMUNITY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Initial headline. It is replaced by the active card's title once the carousel runs.",
      "default": "Worn by you, every day"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slides",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_duration",
      "label": "Slide duration",
      "min": 3000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "default": 6500
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave blank to use the color scheme."
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Text color",
      "info": "Leave blank to use the color scheme."
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text color",
      "info": "Leave blank to use the color scheme."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave blank to use the color scheme."
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 240,
      "max": 420,
      "step": 4,
      "unit": "px",
      "default": 328
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.section_padding.top_padding.label",
      "default": 0,
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.section_padding.bottom_padding.label",
      "default": 0,
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:sections.common.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "t:sections.common.divider.show_divider.label",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_width",
      "label": "t:sections.common.divider.width.label",
      "options": [
        {
          "value": "container",
          "label": "t:sections.common.container.fixed"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.common.container.stretched"
        },
        {
          "value": "container-full",
          "label": "t:sections.common.container.fullwidth"
        }
      ],
      "default": "container",
      "visible_if": "{{ section.settings.show_section_divider == true }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.custom_attr.header"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "t:sections.common.custom_attr.custom_id"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.custom_attr.custom_class"
    },
    {
      "type": "header",
      "content": "t:settings_schema.animations.header.content"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "t:settings_schema.animations.header__2.content",
      "options": [
        {
          "value": "inherit",
          "label": "t:settings_schema.animations.settings.animation.options.option_6"
        },
        {
          "value": "fade-in",
          "label": "t:settings_schema.animations.settings.animation.options.option_2"
        },
        {
          "value": "fade-in-up",
          "label": "t:settings_schema.animations.settings.animation.options.option_3"
        },
        {
          "value": "fade-in-left",
          "label": "t:settings_schema.animations.settings.animation.options.option_4"
        },
        {
          "value": "fade-in-right",
          "label": "t:settings_schema.animations.settings.animation.options.option_5"
        }
      ],
      "default": "inherit"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Photo story, or the poster shown until the video plays."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional customer video. Plays muted on loop while the story is active; leave blank for a photo story."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Shown in the left column while this story is active."
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Benefit 3"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Featured on the card with a quick-add button. Leave blank to hide."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UGC story carousel",
      "settings": {
        "color_scheme": "background-1",
        "eyebrow": "LOVED BY OUR COMMUNITY",
        "title": "Worn by you, every day",
        "autoplay": true,
        "slide_duration": 6500,
        "accent_color": "#b0573b",
        "card_width": 328,
        "padding_top": 48,
        "padding_bottom": 48,
        "show_section_divider": false,
        "divider_width": "container",
        "custom_id": "",
        "custom_class": "",
        "animations": "inherit"
      },
      "blocks": [
        {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/hero-worn-daily.png",
            "video": "",
            "title": "The ring that never comes off",
            "benefit_1": "Doubles as my everyday signature",
            "benefit_2": "Pairs with everything I own",
            "benefit_3": "Still perfect after three years",
            "product": "twist-ring-gold"
          }
        },
        {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/card-earrings.png",
            "video": "",
            "title": "Hoops for every day",
            "benefit_1": "Quiet shine from morning to night",
            "benefit_2": "No tarnish after a full year",
            "benefit_3": "The pair I reach for first",
            "product": "gold-hoop-earrings"
          }
        },
        {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/p-pearlneck-1.png",
            "video": "",
            "title": "The compliment magnet",
            "benefit_1": "Elevates even a plain tee",
            "benefit_2": "The comment I get most often",
            "benefit_3": "Bought a second as a gift",
            "product": "pearl-drop-necklace"
          }
        },
        {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/p-rainbow-1.png",
            "video": "",
            "title": "Three bracelets, one stack",
            "benefit_1": "Layers perfectly with gold",
            "benefit_2": "Hand-strung colour that lasts",
            "benefit_3": "Came back for three more",
            "product": "miyuki-bead-bracelet-rainbow"
          }
        },
        {
          "type": "story",
          "settings": {
            "image": "shopify://shop_images/p-parure-1.png",
            "video": "",
            "title": "Said yes in Veloura",
